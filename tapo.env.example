# Environment for the tapo-monitor container (docker-compose.example.yml: env_file).
# Copy to tapo.env (git-ignored) and replace the placeholders. The variable NAMES must
# match the *_env keys in your cameras.yaml; rename both together if you change them.

# Telegram bot (telegram.token_env / telegram.chat_id_env)
TELEGRAM_TOKEN=replace-with-bot-token
TELEGRAM_CHAT_ID=replace-with-chat-id

# Camera Account created in the Tapo app (cameras[].user_env / password_env)
CAM_USER=replace-with-camera-user
CAM_PASSWORD=replace-with-camera-password
# TP-Link cloud password, only for SD-card clip download (cloud_password_env)
# CAM_CLOUD_PASSWORD=replace-with-cloud-password

# RTSP login, usually the same Camera Account (rtsp_user_env / rtsp_password_env)
CAM_RTSP_USER=replace-with-rtsp-user
CAM_RTSP_PASSWORD=replace-with-rtsp-password

# Optional: Groq scene descriptions (groq.api_key_env)
# GROQ_API_KEY=replace-with-groq-key

# Optional: MQTT broker login (mqtt.user_env / mqtt.password_env)
# MQTT_USER=replace-with-mqtt-user
# MQTT_PASSWORD=replace-with-mqtt-password

# Optional photo archives. Setting a variable switches the feature on; both prune
# themselves. Keep them under /data so they survive container re-creation.
# TAPO_SENT_LOG_DIR=/data/sent-log
# TAPO_REVIEW_LOG_DIR=/data/review-log

# Optional: recorder tree for recording fallbacks and the shadow scan. Mount it into
# the container at the same path (see docker-compose.example.yml).
# RECORDING_ROOT=/recordings
