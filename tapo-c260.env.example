# Copy to tapo-c260.env and fill values for the local/home C260 test camera.
TAPO_IP=192.168.0.xxx
TAPO_EMAIL=you@example.com
TAPO_PASSWORD=change-me
ONVIF_USER=admin
ONVIF_PASS=change-me
ONVIF_PORT=2020
RTSP_URL=rtsp://admin:change-me@192.168.0.xxx:554/stream1

# C260 discovery normally does not need Telegram/Groq, but scripts share config names.
TELEGRAM_TOKEN=unused
TELEGRAM_CHAT_ID=unused
GROQ_API_KEY=unused

MONITOR_START=00:00
MONITOR_END=23:59
COOLDOWN=30
RECONCILE_INTERVAL=30
POLL_INTERVAL=3.0
STRICT_PEOPLE=1
NIGHT_START=22
NIGHT_END=6
STATE_FILE=/tmp/tapo_c260_autotrack_state
# Optional local face_id labels from getEvents(): FACE_ID_NAMES=1234567890:petr
FACE_ID_NAMES=
LOG_FACE_IDS=0
