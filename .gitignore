# Secrets / local deployment state
tapo-camera.env
*.env
# `*.env` does NOT match `tapo-camera.env.bak-20260826` — a glob has to end at the
# pattern. The hosts name their backups exactly that way, so a copied-in backup would
# have been staged by `git add -A` with camera credentials in it.
*.env.*
!*.env.example
!.env.example

# Real deployment config (coordinates, hosts, camera layout) — never published.
cameras.yaml
cameras.yml
# go2rtc.yaml embeds the camera's cloud password in its tapo:// source URL
go2rtc.yaml
go2rtc.yml
go2rtc.yaml.*
go2rtc.yml.*
cameras.*.yaml
cameras.*.yml
cameras-*.yaml
cameras-*.yml
# Same hole, same reason: `cameras.yaml.bak-cropnative-20260807` is the live convention.
cameras.yaml.*
cameras.yml.*
cameras.*.yaml.*
cameras.*.yml.*
!cameras.example.yaml
!cameras.minimal.yaml
# Local Compose file copied from docker-compose.example.yml (host paths, image pins).
docker-compose.yml
docker-compose.yaml
docker-compose.yml.*
docker-compose.yaml.*
compose.yaml
compose.yml
compose.yaml.*
compose.yml.*
.envrc
.envrc.*
.direnv/
!.envrc.example

