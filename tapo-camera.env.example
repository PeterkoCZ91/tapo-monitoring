TAPO_IP=192.168.1.100
TAPO_EMAIL=you@example.com
TAPO_PASSWORD=change-me
ONVIF_USER=admin
ONVIF_PASS=change-me
ONVIF_PORT=2020
TELEGRAM_TOKEN=123456:ABC-...
TELEGRAM_CHAT_ID=123456789
GROQ_API_KEY=gsk_...
MONITOR_START=22:30
MONITOR_END=05:30
# groq_watch denni okno — default 05:30-22:30 (navazuje na person_monitor, zadna ranni dira)
GROQ_MONITOR_START=05:30
GROQ_MONITOR_END=22:30
# Po jak dlouhem nepretrzitem vypadku spojeni s kamerou poslat Telegram alert (s).
CAMERA_DOWN_ALERT_SEC=900
# Jak casto v noci person_monitor znovu potvrdi auto-tracking, kdyz ho kamera shodi (s).
AUTOTRACK_REASSERT_INTERVAL=300
# camera_automation: min. odstup mezi alerty "nedostupna kamera" (s) — proti spamu z minutoveho timeru.
UNREACHABLE_ALERT_COOLDOWN=3600
COOLDOWN=120
RECONCILE_INTERVAL=60
POLL_INTERVAL=3.0
STRICT_PEOPLE=1
NIGHT_START=22
NIGHT_END=6
# Astral sunset/sunrise window pro camera_automation.py.
# Vyplň souřadnice + IANA timezone pro plynulý přechod podle slunce.
# Pokud zůstanou prázdné nebo astral není nainstalovaný, použije se NIGHT_START/NIGHT_END HH:MM fallback.
NIGHT_LAT=
NIGHT_LON=
NIGHT_TZ=
NIGHT_SUNSET_OFFSET_MIN=30
NIGHT_SUNRISE_OFFSET_MIN=30
NIGHT_FORCE_HHMM=0
# Preset, na který se kamera vrací ráno (den) a volitelně přes noc.
DAY_PRESET=2
NIGHT_PRESET=
STATE_FILE=/tmp/tapo_autotrack_state
# Déšť (camera_automation): při dešti se sníží citlivost detekce pohybu (kapky/odlesky).
# MUSÍ být čísla 0-100 (pytapo přemapuje číselný string na label). normal 60, déšť 20.
MOTION_SENS_NORMAL=60
MOTION_SENS_RAIN=20
# Práh srážek (mm) pro "prší", doběh rain-mode po dešti (s), a jak často fetchovat open-meteo (s).
RAIN_PRECIP_THRESHOLD=0.1
RAIN_CLEAR_DELAY=1800
RAIN_POLL_INTERVAL=900
# Lokalita pro srážky — když prázdné, vezme se z NIGHT_LAT/NIGHT_LON/NIGHT_TZ.
RAIN_LAT=
RAIN_LON=
RAIN_TZ=
RETURN_DELAY=90
HOME_PRESET=2
SUBSCRIPTION_MAXAGE=540
SNAP_DELAY=1.5
SNAP_FRAMES=3
# Optional local face_id labels from getEvents(): FACE_ID_NAMES=1234567890:petr,2345678901:jana
FACE_ID_NAMES=
# Keep raw stable face IDs out of logs unless actively researching mappings.
LOG_FACE_IDS=0
