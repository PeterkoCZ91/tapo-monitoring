[Unit]
OnFailure=pi-failure-notify@%n.service
Description=Tapo Camera Automation (auto-tracking day/night)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=user
EnvironmentFile=/home/user/tapo/tapo-camera.env
ExecStart=/home/user/tapo-env/bin/python /home/user/tapo/camera_automation.py
StandardOutput=journal
StandardError=journal
