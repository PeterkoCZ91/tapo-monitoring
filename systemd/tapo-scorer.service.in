[Unit]
Description=tapo-monitor shared YOLO scoring service
After=network-online.target
Wants=network-online.target
# Restart=always alone retries a crash loop forever in silence, and this is the host every
# camera depends on: a scorer that never comes back degrades the whole fleet to raw
# passthrough without anyone being told. With RestartSec=30, 20 starts in 15 minutes
# tolerates ~10 minutes of boot-time retries (model/GPU/network not ready) before a real
# crash loop is declared failed and reported.
StartLimitIntervalSec=900
StartLimitBurst=20
OnFailure=pi-failure-notify@%n.service

[Service]
Type=simple
User=@SCORER_USER@
# Intel iGPU inference (TAPO_SCORER_PROVIDER=openvino-gpu) opens /dev/dri/renderD128;
# without this group only a logged-in seat's ACL grants access, and a headless boot
# would silently fall back to CPU.
SupplementaryGroups=render
EnvironmentFile=/etc/tapo-monitor/scorer.env
# Optional shared token (see docs/operations.md, "Shared token"): put
#   TAPO_SCORER_TOKEN_FILE=/etc/tapo-monitor/scorer.token   (mode 0600, service user)
# in scorer.env, or hand the file over as a credential instead of reading it from disk:
#   LoadCredential=scorer-token:/etc/tapo-monitor/scorer.token
#   Environment=TAPO_SCORER_TOKEN_FILE=%d/scorer-token
# Comments only; with neither line the service stays open as before.
# With `-m`, Python imports the package from the working directory, so a host that keeps
# the package as a copy here and one that pip-installed it into the venv both work.
WorkingDirectory=@SCORER_HOME@
# systemd expands ${VAR} in arguments but never in the executable itself — that is why
# this file is rendered by tools/provision_scorer.sh instead of being copied and edited.
#
# The durable-metrics settings (TAPO_SCORER_METRICS_*) stay in the env file and are read
# from there by the process: an undefined ${VAR} outside quotes drops the word entirely,
# and argparse would exit before the model loads — an invisible crash loop caused by an
# observability setting.
ExecStart=@SCORER_PYTHON@ -m tapo_monitor.scorer_service --model ${TAPO_SCORER_MODEL} --port ${TAPO_SCORER_PORT} --input-size ${TAPO_SCORER_INPUT_SIZE}
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
