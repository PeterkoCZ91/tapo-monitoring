[Unit]
OnFailure=pi-failure-notify@%n.service
Description=Tapo Person Monitor (ONVIF + Telegram)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/tapo
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/user/tapo/tapo-camera.env
ExecStart=/home/user/tapo-env/bin/python -u /home/user/tapo/person_monitor.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
