# Required model/runtime settings for tapo-scorer@.service.
TAPO_SCORER_MODEL=/opt/tapo-monitor/models/yolox_m.onnx
TAPO_SCORER_PORT=8766
TAPO_SCORER_INPUT_SIZE=640

# Aggregate-only metrics. The directory must be writable by the systemd User=%i.
# These four are read by the process from this file, not passed on the command line:
# an undefined ${VAR} in ExecStart expands to nothing and the service would exit before
# the model loads. Unset, blank or unparseable values fall back to the defaults below.
TAPO_SCORER_METRICS_FILE=/opt/tapo-monitor/data/scorer.jsonl
TAPO_SCORER_METRICS_PERSIST_SECONDS=60
TAPO_SCORER_METRICS_RETENTION_DAYS=7
TAPO_SCORER_METRICS_RETENTION_FILES=8
