# Settings for tapo-scorer.service. tools/provision_scorer.sh writes this file with the
# host's real paths on its first run and never touches it again — this copy documents the
# variables for anyone editing an existing one by hand.

# Required model/runtime settings. The unit fails to start without them.
TAPO_SCORER_MODEL=/srv/tapo-scorer/yolox_m.onnx
TAPO_SCORER_PORT=8766
TAPO_SCORER_INPUT_SIZE=640

# Aggregate-only metrics. The directory must be writable by the unit's User=.
# These are read by the process from this file, not passed on the command line:
# an undefined ${VAR} in ExecStart expands to nothing and the service would exit before
# the model loads. Unset, blank or unparseable values fall back to the defaults below.
TAPO_SCORER_METRICS_FILE=/srv/tapo-scorer/metrics/scorer.jsonl
TAPO_SCORER_METRICS_PERSIST_SECONDS=60
TAPO_SCORER_METRICS_RETENTION_DAYS=7
TAPO_SCORER_METRICS_RETENTION_FILES=8
# Size backstop on top of the age rotation: the journal also rotates once it outgrows
# this many bytes (default 32 MiB), so a burst cannot outgrow the disk between age checks.
TAPO_SCORER_METRICS_MAX_JOURNAL_BYTES=33554432
