[Unit]
Description=tapo-monitor — config-driven Tapo camera monitoring
After=network-online.target
Wants=network-online.target
# Restart=always alone retries a crash loop forever in silence — an ImportError from
# a half-copied package never self-heals. Stop after 5 starts in 5 minutes and report.
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=pi-failure-notify@%n.service

[Service]
Type=simple
# For a system unit, set the concrete service user (%i would expand to nothing in a
# non-template unit); a user unit (`systemctl --user`) needs no User= at all. %h below
# is the home of the user the *manager* runs as, so it is only right for a user unit;
# in a system unit spell the service user's home out absolutely instead.
#User=tapo
EnvironmentFile=-/etc/tapo-monitor/secrets.env
# The release layout maintained by tools/deploy_release.sh: `current` is a symlink to
# one release directory under ~/tapo-monitor/releases/, switched by a single rename —
# so a rollback is re-pointing the link, and this unit never needs an edit for either.
WorkingDirectory=%h/tapo-monitor/current
# The interpreter must be an absolute path into the service venv (adjust it): systemd
# activates no venv and searches no PATH. With `-m`, Python finds the package in the
# working directory, i.e. in whichever release `current` points at right now.
ExecStart=%h/tapo-env/bin/python -m tapo_monitor run %h/tapo-monitor/cameras.yaml
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
